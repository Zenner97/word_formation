<script>
(() => {
  const search = document.getElementById('search');
  const cards = [...document.querySelectorAll('.word-card')];
  const buttons = [...document.querySelectorAll('.alpha-btn')];
  const count = document.getElementById('resultCount');
  const empty = document.getElementById('emptyState');

  let activeLetter = 'ALL';

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach(card => {
      const matchesText = !query || card.dataset.search.includes(query);
      const matchesLetter =
        activeLetter === 'ALL' || card.dataset.letter === activeLetter;
      const show = matchesText && matchesLetter;

      card.hidden = !show;
      if (show) visible++;
    });

    count.textContent = visible + (visible === 1 ? ' карточка' : ' карточки');
    empty.style.display = visible ? 'none' : 'block';
  }

  search.addEventListener('input', applyFilters);

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      activeLetter = button.dataset.letter;
      buttons.forEach(b => b.classList.toggle('active', b === button));
      applyFilters();
      window.scrollTo({ top: document.querySelector('.controls-wrap').offsetTop, behavior: 'smooth' });
    });
  });

  applyFilters();
})();</script>
