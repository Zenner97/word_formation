    } else {
      document.getElementById('theoryFinishIcon').textContent = '⌁';
      document.getElementById('theoryFinishTitle').textContent = 'Откройте все 5 разделов';
      document.getElementById('theoryFinishText').textContent = 'После этого откроются карточки, практика и ЕГЭ.';
    }
  }

  topics.forEach(details => {
    details.addEventListener('toggle', () => {
      if (!details.open) return;

      const topic = details.dataset.theoryTopic;
      if (!theoryState.seen.includes(topic)) {
        theoryState.seen.push(topic);
        saveTheoryState();
        updateTheoryUI();
      }
    });
  });

  finishBtn.addEventListener('click', () => {
    if (!isCompleteReady() && !theoryState.completed) return;

    theoryState.completed = true;
    saveTheoryState();
    updateTheoryUI();
    setViewDirect('cardsView');
  });

  // Always open Theory first when the page is loaded.
  setViewDirect('theoryView');

  updateTheoryUI();
})();
</script></body>
</html>
