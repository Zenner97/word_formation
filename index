  const ROOTS = [...document.querySelectorAll('.word-card h2')].map(x => x.textContent.trim());

  const WORD_FAMILIES = [...document.querySelectorAll('.word-card')].reduce((acc, card) => {
    const root = card.querySelector('h2')?.textContent.trim();
    if (!root) return acc;
    const forms = [
      root,
      ...[...card.querySelectorAll('.family-word')].map(el => el.textContent.trim())
    ].filter(Boolean);
    acc[root] = [...new Set(forms)];
    return acc;
  }, {});

  const FORM_TO_ROOT = Object.entries(WORD_FAMILIES).reduce((acc, [root, forms]) => {
    forms.forEach(form => {
      const clean = form.split('/')[0].trim().toLowerCase();
      if (clean && !acc[clean]) acc[clean] = root;
    });
    return acc;
  }, {});


  const STORAGE_KEY = 'wordFormationEgeTrainer_v3';
  const INTERVAL_DAYS = [1, 3, 7, 14, 30, 60];

  const defaultState = () => ({
    roots: {},
    mistakes: {},
    drillCorrect: 0,
    drillTotal: 0,
    egeCorrect: 0,
    egeTotal: 0,
    egeRuns: 0
  });

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      return Object.assign(defaultState(), JSON.parse(raw));
    } catch (e) {
      return defaultState();
    }
  }

  let state = loadState();

  function saveState() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function rootState(root) {
    if (!state.roots[root]) {
      state.roots[root] = { seen: false, level: 0, due: 0, correct: 0, wrong: 0 };
    }
    return state.roots[root];
  }

  function todayDue(root) {
    const s = rootState(root);
    return s.seen && (!s.due || s.due <= Date.now());
  }

  function mastered(root) {
    return rootState(root).seen && rootState(root).level >= 4;
  }

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function normalizeAnswer(s) {
    return (s || '')
      .trim()
      .toLowerCase()
      .replace(/[’]/g, "'")
      .replace(/\s+/g, '');
  }

  // ---------- Navigation ----------
