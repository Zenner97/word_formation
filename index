/* ===== Rich interface refinement ===== */

:root {
  --rich-blue: #315efb;
  --rich-indigo: #5b55e7;
  --rich-cyan: #39b9ce;
  --rich-green: #38a66b;
  --rich-red: #d76363;
  --rich-ink: #172743;
  --rich-muted: #74839a;
  --rich-line: rgba(31, 52, 87, .09);
  --rich-shadow: 0 12px 34px rgba(31, 53, 91, .095);
}

body {
  background:
    radial-gradient(circle at 10% 0%, rgba(49,94,251,.08), transparent 25rem),
    radial-gradient(circle at 95% 18%, rgba(91,85,231,.055), transparent 22rem),
    #f4f6fb;
}

.panel,
.method-card,
.algorithm-card,
.metric-card,
.study-stat {
  border-color: rgba(42,67,107,.09);
  box-shadow: var(--rich-shadow);
}

.bottom-nav {
  border-top-color: rgba(42,67,107,.10);
  background: rgba(255,255,255,.94);
  box-shadow: 0 -10px 28px rgba(31,53,91,.08);
}

.nav-btn {
  position: relative;
  transition: .18s ease;
}

.nav-btn.active {
  background: linear-gradient(145deg, #edf3ff, #f2efff);
  color: #294fc5;
}

.nav-btn.active::before {
  content: "";
  position: absolute;
  top: 2px;
  left: 28%;
  right: 28%;
  height: 2px;
  border-radius: 99px;
  background: linear-gradient(90deg, #3564fa, #7763e8);
}

/* Rich reusable section hero */
.section-hero {
  position: relative;
  overflow: hidden;
  min-height: 132px;
  margin: 0 0 11px;
  padding: 17px 16px;
  display: flex;
  align-items: center;
