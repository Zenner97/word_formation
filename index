}

.mistake-pill {
  padding: 4px 6px;
  border-radius: 7px;
  background: #fff0f0;
  color: #a14b4b;
  font-size: 9.5px;
  font-weight: 800;
}

.weak-family-line {
  display: flex;
  gap: 4px;
  align-items: center;
  overflow-x: auto;
  margin-top: 7px;
  padding-top: 7px;
  border-top: 1px solid #e9edf4;
  color: #75849a;
  font-size: 9.5px;
  white-space: nowrap;
  scrollbar-width: none;
}

.weak-family-line::-webkit-scrollbar { display:none; }

.weak-family-line span {
  padding: 3px 5px;
  border-radius: 6px;
  background: #eef2f8;
}

.weak-family-line .family-root-pill {
  background: #e7efff;
  color: #3158b5;
  font-weight: 900;
}

.weak-family-line i {
  color: #b3bdca;
  font-style: normal;
}

/* Keep dangerous secondary action visually quiet */
.danger-panel {
  border: 1px solid rgba(175,83,83,.10);
  background: rgba(255,255,255,.70);
  box-shadow: none;
}

@media (max-width: 430px) {
  .section-hero {
    min-height: 118px;
    padding: 15px 14px;
    border-radius: 17px;
  }

  .section-hero h1 {
    font-size: 26px;
  }

  .hero-orb {
    width: 54px;
    height: 54px;
    border-radius: 18px;
  }

  .algorithm-mini {
    padding: 6px 7px;
  }

  .share-actions {
    grid-template-columns: 1.15fr 1fr;
  }
}

/* ===== Theory section ===== */

.theory-shell {
  width: min(100%, 760px);
  margin: 0 auto;
  padding: 9px 9px 45px;
}

#theoryView {
  min-height: calc(100dvh - 70px);
  background:
    radial-gradient(circle at 5% 0%, rgba(49,94,251,.11), transparent 25rem),
    radial-gradient(circle at 95% 15%, rgba(92,81,226,.07), transparent 22rem),
    #f4f6fb;
}

.theory-hero {
  position: relative;
  overflow: hidden;
  min-height: 148px;
  padding: 18px 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  border-radius: 20px;
  background: linear-gradient(135deg, #163f9e 0%, #315ed6 55%, #6659df 100%);
  color: #fff;
  box-shadow: 0 15px 35px rgba(32,64,154,.20);
}

.theory-hero::after {
  content: "";
  position: absolute;
  width: 190px;
  height: 190px;
  top: -95px;
  right: -65px;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
}

.theory-hero-copy {
  position: relative;
  z-index: 2;
  max-width: 520px;
}

.theory-chip {
  display: inline-flex;
  padding: 5px 8px;
  border: 1px solid rgba(255,255,255,.20);
  border-radius: 999px;
  background: rgba(255,255,255,.10);
  color: rgba(255,255,255,.82);
  font-size: 8.5px;
  font-weight: 950;
  letter-spacing: .11em;
}

.theory-hero h1 {
  margin: 9px 0 5px;
  font-size: 31px;
  line-height: 1;
  letter-spacing: -.04em;
}

.theory-hero p {
  max-width: 490px;
  margin: 0;
  color: rgba(255,255,255,.75);
  font-size: 11.5px;
  line-height: 1.42;
}

.theory-hero-mark {
  position: relative;
  z-index: 2;
  flex: 0 0 63px;
  height: 63px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 20px;
  background: rgba(255,255,255,.12);
  color: #fff;
  font-family: Georgia, serif;
  font-size: 23px;
  font-weight: 900;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.16);
}

.theory-hero-mark span {
  position: absolute;
  right: 10px;
  top: 8px;
  font-family: inherit;
  font-size: 10px;
  opacity: .7;
}

/* Anatomy */
.word-anatomy {
  margin-top: 9px;
  padding: 14px;
  border: 1px solid rgba(35,59,96,.08);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 10px 28px rgba(31,53,91,.075);
}

.anatomy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.anatomy-head span,
.anatomy-head b {
  display: block;
}

.anatomy-head span {
  color: #9aa5b5;
  font-size: 8.5px;
  font-weight: 950;
  letter-spacing: .10em;
}

.anatomy-head b {
  margin-top: 2px;
  color: #293f60;
  font-size: 13px;
}

.anatomy-badge {
  padding: 5px 7px;
  border-radius: 8px;
  background: #edf3ff;
  color: #3157b8;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .07em;
}

.word-build {
  display: grid;
  grid-template-columns: 1fr auto 1.3fr auto 1fr;
  gap: 5px;
  align-items: stretch;
  margin-top: 12px;
}

.word-build > i {
  align-self: center;
  color: #adb8c7;
  font-size: 14px;
  font-style: normal;
  font-weight: 900;
}

.morph {
  min-width: 0;
  padding: 9px 8px;
  border-radius: 11px;
}

.morph small,
.morph b,
.morph span {
  display: block;
}

.morph small {
  color: #8997aa;
  font-size: 8px;
  font-weight: 850;
}

.morph b {
  margin-top: 2px;
  font-size: 18px;
  line-height: 1;
}

.morph span {
  margin-top: 5px;
  color: #8794a5;
  font-size: 8.5px;
  line-height: 1.15;
}

.morph-prefix {
  background: #fff1f0;
}

.morph-prefix b { color: #ba5a51; }

.morph-root {
  background: #edf3ff;
}

.morph-root b { color: #2855ba; }

.morph-suffix {
  background: #eef9f3;
}

.morph-suffix b { color: #37845b; }

.word-result {
  margin-top: 7px;
  padding: 9px 11px;
  display: flex;
  align-items: center;
  gap: 9px;
  border-radius: 11px;
  background: linear-gradient(135deg, #f8faff, #f6f5fc);
}

.word-result > span {
  color: #63758e;
  font-size: 17px;
  font-weight: 900;
}

.word-result b,
.word-result small {
  display: block;
}

.word-result b {
  color: #233d68;
  font-size: 16px;
}

.word-result small {
  color: #8c99a9;
  font-size: 9.5px;
}

.anatomy-note {
  margin-top: 9px;
  color: #708097;
  font-size: 10.5px;
  line-height: 1.42;
}

.anatomy-note b {
  color: #3b516f;
}

/* Theory progress */
.theory-progress-card {
  margin-top: 9px;
  padding: 11px 12px;
  border: 1px solid rgba(35,59,96,.08);
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 22px rgba(31,53,91,.06);
}

.theory-progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.theory-progress-top span,
.theory-progress-top b {
  display: block;
}

.theory-progress-top > div:first-child > span {
  color: #9ba7b7;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .10em;
}

.theory-progress-top b {
  margin-top: 1px;
  color: #344b6d;
  font-size: 11.5px;
}

.theory-progress-pct {
  color: #3157bb;
  font-size: 12px;
  font-weight: 950;
}

.theory-progress-track {
  height: 5px;
  margin-top: 8px;
  overflow: hidden;
  border-radius: 99px;
  background: #edf1f6;
}

#theoryProgressBar {
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #315efb, #6858df);
  transition: width .24s ease;
}

.theory-progress-dots {
  display: flex;
  gap: 5px;
  margin-top: 7px;
}

.theory-progress-dots i {
  flex: 1;
  height: 3px;
  border-radius: 99px;
  background: #e5eaf1;
  transition: .18s ease;
}

.theory-progress-dots i.seen {
  background: #4d68dc;
}

.theory-section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 9px;
  margin: 14px 2px 6px;
}

.theory-section-label span {
  color: #a0aab8;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .11em;
}

.theory-section-label b {
  color: #53657c;
  font-size: 10px;
}

/* Topics */
.theory-topic {
  overflow: hidden;
  margin-bottom: 7px;
  border: 1px solid rgba(35,59,96,.09);
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 23px rgba(31,53,91,.055);
}

.theory-topic > summary {
  min-height: 58px;
  padding: 8px 11px;
  display: grid;
  grid-template-columns: 34px 1fr auto;
  gap: 9px;
  align-items: center;
  cursor: pointer;
  list-style: none;
  -webkit-tap-highlight-color: transparent;
}

.theory-topic > summary::-webkit-details-marker {
  display: none;
}

.topic-number {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(145deg, #edf3ff, #f2efff);
  color: #405bc2;
  font-size: 9px;
  font-weight: 950;
}

.topic-summary-copy {
  min-width: 0;
}

.topic-summary-copy b,
.topic-summary-copy span {
  display: block;
}

.topic-summary-copy b {
  color: #293f60;
  font-size: 12px;
}

.topic-summary-copy b em {
  margin-left: 4px;
  color: #9aa6b6;
  font-size: 9px;
  font-style: normal;
  font-weight: 750;
}

.topic-summary-copy span {
  margin-top: 2px;
  overflow: hidden;
  color: #8a98a9;
  font-size: 9.5px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-status {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #a0acba;
}

.topic-status span {
  font-size: 8.5px;
  font-weight: 800;
}

.topic-status i {
  font-size: 14px;
  font-style: normal;
  transition: transform .18s ease;
}

.theory-topic[open] .topic-status i {
  transform: rotate(180deg);
}

.theory-topic.seen .topic-status span {
  color: #458561;
}

.theory-topic.seen .topic-status span::before {
  content: "✓ ";
}

.theory-topic.seen .topic-status span {
  font-size: 0;
}

.theory-topic.seen .topic-status span::before {
  font-size: 9px;
  content: "✓ изучено";
}

.topic-body {
  padding: 0 11px 12px;
  border-top: 1px solid #edf1f5;
}

.theory-rule {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 9px;
  margin-top: 10px;
  padding: 10px;
  border-radius: 11px;
  background: #f8faff;
}

.rule-token {
  display: grid;
  place-items: center;
  min-height: 48px;
  border-radius: 10px;
  background: #e7efff;
  color: #3157b9;
  font-size: 17px;
  font-weight: 950;
}

.negative-rule .rule-token {
  background: #fff0ef;
  color: #b85851;
}

.rule-copy > b {
  display: block;
  color: #324968;
  font-size: 11px;
}

.rule-copy > p {
  margin: 3px 0 0;
  color: #8190a3;
  font-size: 9.5px;
}

.word-pairs {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 6px;
}

.word-pairs span {
  padding: 4px 6px;
  border-radius: 7px;
  background: #fff;
  color: #6d7c90;
  font-size: 9px;
}

.word-pairs strong {
  color: #3156ad;
}

.prefix-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-top: 7px;
}

.prefix-grid.two {
  grid-template-columns: 1fr 1fr;
}

.mini-rule {
  padding: 9px;
  border-radius: 10px;
  background: #f7f9fc;
}

.mini-rule b,
.mini-rule span,
.mini-rule small {
  display: block;
}

.mini-rule b {
  color: #3158b8;
  font-size: 15px;
}

.mini-rule span {
  margin-top: 2px;
  color: #536780;
  font-size: 9.5px;
  font-weight: 800;
}

.mini-rule small {
  margin-top: 5px;
  color: #8794a4;
  font-size: 8.7px;
  line-height: 1.4;
}

.accent-amber b { color: #a36b2c; }
.accent-blue b { color: #3158b8; }

.theory-alert {
  margin-top: 7px;
  padding: 8px 9px;
  display: flex;
  gap: 8px;
  border: 1px solid #f0dddd;
  border-radius: 10px;
  background: #fff8f7;
  color: #755f61;
  font-size: 9.5px;
  line-height: 1.4;
}

.theory-alert > span {
  flex: 0 0 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: #ffebe8;
  color: #b75d52;
  font-weight: 950;
}

.theory-alert.soft {
  border-color: #e3e8f0;
  background: #f8fafc;
  color: #687990;
}

.theory-alert.soft > span {
  background: #eaf0fa;
  color: #4f68a8;
}

/* Suffix tables */
.suffix-table {
  display: grid;
  gap: 5px;
  padding-top: 9px;
}

.suffix-row {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 8px;
  padding: 8px 9px;
  border-radius: 10px;
  background: #f8fafd;
}

.suffix-row > b {
  color: #3b59aa;
  font-size: 12px;
}

.suffix-row div span,
.suffix-row div small {
  display: block;
}

.suffix-row div span {
  color: #52657e;
  font-size: 9.5px;
  font-weight: 800;
}

.suffix-row div small {
  margin-top: 3px;
  color: #8996a6;
  font-size: 8.7px;
  line-height: 1.38;
}

.suffix-row.important {
  background: linear-gradient(135deg, #f1f5ff, #f6f5fc);
}

.suffix-row.important > b {
  color: #3157bb;
}

/* Adverbs */
.adverb-rules {
  display: grid;
  gap: 5px;
  padding-top: 9px;
}

.adverb-rule {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 9px;
  border-radius: 10px;
  background: #f8fafd;
}

.adverb-rule em {
  flex: 0 0 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #e9effb;
  color: #3d5aaa;
  font-size: 9px;
  font-style: normal;
  font-weight: 950;
}

.adverb-rule b,
.adverb-rule span {
  display: block;
}

.adverb-rule b {
  color: #3b4f6c;
  font-size: 10.5px;
}

.adverb-rule span {
  margin-top: 2px;
  color: #8190a3;
  font-size: 9.5px;
}

.adverb-rule strong {
  color: #3158b5;
}

.exception-box {
  margin-top: 7px;
  padding: 9px;
  border-radius: 10px;
  background: #fff8ef;
}

.exception-box > span {
  color: #a47431;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .09em;
}

.exception-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
  margin-top: 6px;
}

.exception-grid div {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 6px;
  border-radius: 7px;
  background: rgba(255,255,255,.70);
  color: #7b6d59;
  font-size: 9.5px;
}

.exception-grid i {
  color: #bc9b69;
  font-style: normal;
}

.exception-grid strong {
  color: #92682b;
}

/* Finish gate */
.theory-finish {
  margin-top: 10px;
  padding: 12px;
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 10px;
  border: 1px solid rgba(35,59,96,.09);
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 10px 28px rgba(31,53,91,.07);
}

.finish-lock {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #f0f3f8;
  color: #8796a9;
  font-size: 17px;
  font-weight: 950;
}

.finish-copy span,
.finish-copy b,
.finish-copy p {
  display: block;
}

.finish-copy span {
  color: #9aa6b6;
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .09em;
}

.finish-copy b {
  margin-top: 2px;
  color: #344a68;
  font-size: 11.5px;
}

.finish-copy p {
  margin: 2px 0 0;
  color: #8b98a9;
  font-size: 9.5px;
}

#finishTheoryBtn {
  grid-column: 1 / -1;
  min-height: 43px;
  border: 0;
  border-radius: 11px;
  background: #e9edf3;
  color: #9aa6b5;
  font: inherit;
  font-size: 11px;
  font-weight: 900;
  cursor: not-allowed;
}

#finishTheoryBtn.ready {
  background: linear-gradient(135deg, #315efb, #6858df);
  color: #fff;
  box-shadow: 0 8px 18px rgba(49,94,251,.18);
  cursor: pointer;
}

#finishTheoryBtn span {
  margin-left: 5px;
  font-size: 14px;
}

/* Theory lock feedback */
.theory-gate-toast {
  position: fixed;
  z-index: 300;
  left: 50%;
  bottom: 82px;
  width: min(calc(100% - 24px), 430px);
  transform: translate(-50%, 20px);
  padding: 10px 12px;
  border: 1px solid rgba(39,63,102,.10);
  border-radius: 12px;
  background: rgba(24,39,64,.94);
  color: #fff;
  box-shadow: 0 12px 32px rgba(19,33,56,.20);
  font-size: 10.5px;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: .2s ease;
}

.theory-gate-toast.show {
  transform: translate(-50%, 0);
  opacity: 1;
}

body.theory-locked .nav-btn[data-theory-gated="1"] {
  opacity: .52;
}

body.theory-locked .nav-btn[data-theory-gated="1"]::after {
  content: "•";
  position: absolute;
  top: 5px;
  right: 24%;
  color: #9aa6b5;
  font-size: 10px;
}

@media (max-width: 430px) {
  .theory-shell {
    padding: 6px 6px 38px;
  }

  .theory-hero {
    min-height: 137px;
    padding: 16px 14px;
    border-radius: 18px;
  }

  .theory-hero h1 {
    font-size: 27px;
  }

  .theory-hero p {
    font-size: 10.7px;
  }

  .theory-hero-mark {
    flex-basis: 55px;
    height: 55px;
    border-radius: 18px;
  }

  .word-anatomy {
    padding: 11px;
  }

  .word-build {
    grid-template-columns: 1fr auto 1.2fr auto 1fr;
    gap: 3px;
  }

  .morph {
    padding: 8px 6px;
  }

  .morph b {
    font-size: 15px;
  }

  .morph span {
    font-size: 7.7px;
  }

  .prefix-grid {
    grid-template-columns: 1fr;
  }

  .prefix-grid.two {
    grid-template-columns: 1fr 1fr;
  }

  .suffix-row {
    grid-template-columns: 65px 1fr;
    padding: 8px;
  }

  .bottom-nav {
    grid-template-columns: repeat(5, 1fr) !important;
  }

  .nav-btn b {
    font-size: 8.6px;
  }

  .nav-btn span {
    font-size: 12px;
  }
}

@media (min-width: 431px) {
  .bottom-nav {
    grid-template-columns: repeat(5, 1fr) !important;
  }
}

@media print {
  #theoryView {
    display: block !important;
  }

  .theory-topic {
    break-inside: avoid;
  }

  .theory-topic > .topic-body {
    display: block !important;
  }
}

/* ===== Theory v2: larger typography, free navigation ===== */

/* Theory text */
.theory-hero p { font-size: 14px !important; line-height: 1.48 !important; }
.anatomy-head span { font-size: 10px !important; }
.anatomy-head b { font-size: 15px !important; }
.anatomy-badge { font-size: 9px !important; }

.morph small { font-size: 10px !important; }
.morph b { font-size: 21px !important; }
.morph span { font-size: 11px !important; line-height: 1.25 !important; }

.word-result b { font-size: 18px !important; }
.word-result small { font-size: 12px !important; }
.anatomy-note { font-size: 13px !important; line-height: 1.48 !important; }

.theory-progress-top > div:first-child > span { font-size: 9.5px !important; }
.theory-progress-top b { font-size: 13px !important; }
.theory-progress-pct { font-size: 14px !important; }

.theory-section-label span { font-size: 9.5px !important; }
.theory-section-label b { font-size: 12px !important; }

.theory-topic > summary { min-height: 66px !important; }
.topic-number { width: 36px !important; height: 36px !important; font-size: 10px !important; }
.topic-summary-copy b { font-size: 14.5px !important; }
.topic-summary-copy b em { font-size: 11px !important; }
