  function buildSession(useWeak = false) {
    weakMode = useWeak;
    let roots;

    if (useWeak) {
      const ranked = Object.entries(state.mistakes)
        .sort((a,b) => b[1] - a[1])
        .map(([answer]) => {
          const q = PRACTICE.find(x => x.answer === answer);
          return q ? q.root : null;
        })
        .filter(Boolean);
      roots = [...new Set(ranked)].slice(0, 16);
      if (!roots.length) roots = shuffle(ROOTS.filter(r => rootState(r).seen)).slice(0, 12);
    } else {
      const dueRoots = shuffle(ROOTS.filter(todayDue)).slice(0, 8);
      const newRoots = shuffle(ROOTS.filter(r => !rootState(r).seen)).slice(0, 8);
      roots = [...dueRoots, ...newRoots];
      if (!roots.length) {
        roots = shuffle(ROOTS).slice(0, 12);
      }
    }

    session = roots.map(root => {
      const qs = questionsForRoot(root);
      return qs.length ? qs[Math.floor(Math.random() * qs.length)] : null;
    }).filter(Boolean);

    sessionIndex = 0;
    sessionCorrect = 0;
    startCard.classList.add('hidden');
    done.classList.add('hidden');
    quiz.classList.remove('hidden');
    showStudyQuestion();
  }

  function showStudyQuestion() {
    if (sessionIndex >= session.length) {
      finishStudy();
      return;
    }

    currentQ = session[sessionIndex];
    currentAnswered = false;
    studyInput.value = '';
    studyInput.disabled = false;
    studyInput.classList.remove('correct', 'wrong');
    studyHint.classList.add('hidden');
    studyFeedback.className = 'feedback hidden';
    studyNextBtn.classList.add('hidden');
    studyCheckBtn.classList.remove('hidden');

    studyRoot.textContent = currentQ.root.toUpperCase();
    studySentence.textContent = currentQ.blanked;
    studyTranslation.textContent = STUDY_TRANSLATIONS[currentQ.root] || '';
    studyCounter.textContent = `${sessionIndex + 1} / ${session.length}`;
    studyProgressBar.style.width = `${(sessionIndex / Math.max(1, session.length)) * 100}%`;
    setTimeout(() => studyInput.focus(), 80);
  }

  function scheduleResult(root, correct) {
    const s = rootState(root);
    s.seen = true;

    if (correct) {
      s.correct = (s.correct || 0) + 1;
      s.level = Math.min(5, (s.level || 0) + 1);
      const days = INTERVAL_DAYS[Math.max(0, s.level - 1)] || 60;
      s.due = Date.now() + days * 86400000;
    } else {
      s.wrong = (s.wrong || 0) + 1;
      s.level = Math.max(0, (s.level || 0) - 1);
      // Return later the same day instead of disappearing for a full day.
      s.due = Date.now() + 15 * 60 * 1000;
    }
  }

  function checkStudy() {
    if (!currentQ || currentAnswered) return;
    const user = normalizeAnswer(studyInput.value);
    if (!user) {
      studyInput.focus();
      return;
    }

    const correct = user === normalizeAnswer(currentQ.answer);
    currentAnswered = true;
    state.drillTotal++;

    if (correct) {
      state.drillCorrect++;
      sessionCorrect++;
      studyInput.classList.add('correct');
      studyFeedback.className = 'feedback good';
