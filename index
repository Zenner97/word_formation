  function renderStudyOverview() {
    let due = 0, fresh = 0, master = 0;
    ROOTS.forEach(root => {
      const s = rootState(root);
      if (!s.seen) fresh++;
      if (todayDue(root)) due++;
      if (mastered(root)) master++;
