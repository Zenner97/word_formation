/* ===== Integrated learning system ===== */

body {
  padding-bottom: 72px;
}

.app-view {
  display: none;
}

.app-view.active {
  display: block;
}

.view-shell {
  max-width: 760px;
  margin: 0 auto;
  padding: 13px 10px 44px;
}

.compact-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin: 2px 2px 12px;
}

.section-kicker {
  color: #7d8ca1;
  font-size: 9px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: .12em;
}

.section-title {
  margin: 4px 0 0;
  font-size: 26px;
  line-height: 1.05;
  color: #102457;
  letter-spacing: -.025em;
}

.mini-badge {
  flex: 0 0 auto;
  padding: 6px 9px;
  border-radius: 10px;
  background: var(--blue-soft);
  color: var(--blue-dark);
  font-size: 11px;
  font-weight: 900;
}

.panel,
.method-card {
  margin-bottom: 9px;
  border: 1px solid #e1e8f2;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 5px 18px rgba(25,49,87,.055);
}

.panel {
  padding: 14px;
}

.panel-title {
  color: #182b4d;
  font-size: 16px;
  font-weight: 900;
  line-height: 1.2;
}

.panel-copy {
  margin: 6px 0 12px;
  color: #6d7c90;
  font-size: 13px;
  line-height: 1.4;
}

.method-card {
  overflow: hidden;
}

.method-card > summary {
  min-height: 45px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  list-style: none;
  cursor: pointer;
  color: #263a5b;
  font-size: 13px;
  font-weight: 900;
  -webkit-tap-highlight-color: transparent;
}

.method-card > summary::-webkit-details-marker {
  display: none;
}

.method-card[open] .summary-chevron {
  transform: rotate(180deg);
}

.method-body {
  padding: 0 13px 13px;
}

.method-step {
  padding: 9px 0;
  border-top: 1px solid #edf1f6;
}

.method-step b,
.method-step span {
  display: block;
}

.method-step b {
  margin-bottom: 2px;
  color: #24406c;
  font-size: 12.5px;
}

.method-step span {
  color: #6b7b91;
  font-size: 12.5px;
  line-height: 1.42;
}

.interval-strip {
  display: flex;
  gap: 5px;
  align-items: center;
  overflow-x: auto;
  padding-top: 9px;
  color: #526783;
  font-size: 10.5px;
  font-weight: 800;
  white-space: nowrap;
  scrollbar-width: none;
}

.interval-strip::-webkit-scrollbar {
  display: none;
}

.interval-strip span {
  padding: 5px 7px;
  border-radius: 8px;
  background: #f4f7fb;
}

.interval-strip i {
  color: #9ba8ba;
  font-style: normal;
}

.study-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
  margin-bottom: 9px;
}

.study-stat {
  min-width: 0;
  padding: 10px 8px;
  border: 1px solid #e3e9f2;
  border-radius: 12px;
  background: #fff;
  text-align: center;
}

.study-stat b {
  display: block;
  color: #173b91;
  font-size: 20px;
  line-height: 1;
}

.study-stat span {
  display: block;
  margin-top: 5px;
  color: #8491a4;
  font-size: 9.5px;
  line-height: 1.2;
}

.primary-btn,
.ghost-btn,
.small-btn,
.danger-btn {
  appearance: none;
  border: 0;
  border-radius: 11px;
  font: inherit;
  font-weight: 850;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.primary-btn {
  min-height: 42px;
  padding: 0 15px;
  background: var(--blue);
  color: #fff;
}

.primary-btn:active {
  transform: translateY(1px);
}

.ghost-btn {
  min-height: 40px;
  padding: 0 13px;
  border: 1px solid #dae3ef;
  background: #fff;
  color: #435b7a;
}

.small-btn {
  min-height: 35px;
  padding: 0 11px;
  border: 1px solid #dce5f0;
  background: #f9fbfe;
  color: #4a607e;
  font-size: 12px;
}

.danger-btn {
  min-height: 38px;
  padding: 0 12px;
  background: #fff1f1;
  color: #a13939;
  border: 1px solid #f0caca;
}

.full-btn {
  width: 100%;
}

.full-btn + .full-btn {
  margin-top: 7px;
}

.hidden {
  display: none !important;
}

.quiz-panel {
  padding-top: 12px;
}

.quiz-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  color: #8d9aac;
  font-size: 11px;
  font-weight: 800;
}

.root-chip {
  padding: 5px 8px;
  border-radius: 8px;
  background: #edf3ff;
  color: #1645b0;
  letter-spacing: .06em;
}

.progress-track {
  height: 4px;
  margin: 10px 0 17px;
  overflow: hidden;
  border-radius: 99px;
  background: #ecf0f5;
}

.progress-fill {
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: var(--blue);
  transition: width .2s ease;
}

.quiz-sentence {
  min-height: 72px;
  display: flex;
  align-items: center;
  color: #1e304c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18px;
  line-height: 1.47;
}

.answer-input {
  width: 100%;
  height: 46px;
  margin-top: 11px;
  padding: 0 13px;
  border: 1px solid #d9e2ed;
  border-radius: 11px;
  outline: 0;
  background: #fbfcff;
  color: #172a47;
  font: inherit;
  font-size: 16px;
}

.answer-input:focus {
  border-color: rgba(31,94,255,.55);
  box-shadow: 0 0 0 4px rgba(31,94,255,.08);
}

.answer-input.correct {
  border-color: #4fa86b;
  background: #f3fbf5;
}

.answer-input.wrong {
  border-color: #d46b6b;
  background: #fff6f6;
}

.quiz-actions {
  display: grid;
  grid-template-columns: auto auto 1fr;
  gap: 6px;
  margin-top: 8px;
}

.hint-box,
.feedback {
  margin-top: 9px;
  padding: 10px 11px;
  border-radius: 10px;
  font-size: 12.5px;
  line-height: 1.4;
}

.hint-box {
  background: #f6f8fb;
  color: #617188;
}

.feedback.good {
  background: #eef9f1;
  color: #2f7346;
}

.feedback.bad {
  background: #fff2f2;
  color: #9a4040;
}

.done-mark {
  width: 38px;
  height: 38px;
  margin-bottom: 10px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #eaf8ee;
  color: #2e8b50;
  font-weight: 950;
}

.ege-rule b {
  display: block;
  color: #1b3153;
  font-size: 14px;
}

.ege-rule p {
  margin: 10px 0 0;
  color: #8491a3;
  font-size: 11.5px;
  line-height: 1.4;
}

.ege-algorithm {
  display: grid;
  gap: 6px;
  margin-top: 9px;
}

.ege-algorithm span {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #5e6f86;
  font-size: 12px;
}

.ege-algorithm em {
  flex: 0 0 21px;
  height: 21px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: #edf3ff;
  color: #1e57dc;
  font-size: 10px;
  font-style: normal;
  font-weight: 900;
}

.ege-toolbar {
  margin: 14px 2px 7px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.subtle {
  margin-top: 3px;
  color: #8b98aa;
  font-size: 10.5px;
}

.ege-exam {
  padding: 0;
  overflow: hidden;
}

.ege-intro {
  padding: 13px 14px;
  border-bottom: 1px solid #e8edf4;
  background: #f8faff;
  color: #4c607c;
  font-size: 12.5px;
  line-height: 1.45;
}

.ege-item {
  display: grid;
  grid-template-columns: 36px minmax(0,1fr);
  gap: 8px;
  padding: 13px 14px;
  border-bottom: 1px solid #edf1f5;
}

.ege-item:last-child {
  border-bottom: 0;
}

.ege-num {
  color: #1f5eff;
  font-size: 13px;
  font-weight: 950;
}

.ege-content {
  min-width: 0;
}

.ege-sentence {
  color: #24364f;
  font-size: 14px;
  line-height: 1.5;
}

.ege-row {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 8px;
}

.ege-input {
  min-width: 0;
  flex: 1;
  height: 38px;
  padding: 0 10px;
  border: 1px solid #dbe4ef;
  border-radius: 9px;
  outline: 0;
  background: #fff;
  color: #172a47;
  font: inherit;
  font-size: 16px;
}

.ege-input.correct {
  border-color: #4fa86b;
  background: #f3fbf5;
}

.ege-input.wrong {
  border-color: #d46b6b;
  background: #fff6f6;
}

.ege-base {
  flex: 0 0 auto;
  padding: 6px 8px;
  border-radius: 8px;
  background: #eff3f8;
  color: #51657e;
  font-size: 10.5px;
  font-weight: 900;
  letter-spacing: .05em;
}

.ege-actions {
  margin-top: 8px;
}

.ege-score {
  display: flex;
  align-items: baseline;
  gap: 7px;
  margin-bottom: 10px;
}

.ege-score b {
  color: #143d99;
  font-size: 30px;
  line-height: 1;
}

.ege-score span {
  color: #7b899c;
  font-size: 12px;
}

.ege-review {
  display: grid;
  gap: 7px;
}

.ege-review-item {
  padding: 9px 10px;
  border-radius: 10px;
  background: #f7f9fc;
}

.ege-review-item b {
  color: #253e65;
  font-size: 12px;
}

.ege-review-item p {
  margin: 3px 0 0;
  color: #6b7b90;
  font-size: 11.5px;
  line-height: 1.4;
}

.progress-hero {
  display: flex;
  gap: 14px;
  align-items: center;
}

.big-progress-number {
  flex: 0 0 auto;
  color: #1646ad;
  font-size: 34px;
  font-weight: 950;
  letter-spacing: -.03em;
}

.big-progress-number small {
  color: #9aa6b7;
  font-size: 12px;
  font-weight: 800;
}

.progress-hero b {
  color: #223a5e;
  font-size: 13px;
}

.progress-hero p {
  margin: 3px 0 0;
  color: #8290a3;
  font-size: 11.5px;
  line-height: 1.35;
}

.progress-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin-bottom: 9px;
}

.metric-card {
  padding: 11px;
  border: 1px solid #e1e8f2;
  border-radius: 12px;
  background: #fff;
}

.metric-card span,
.metric-card b,
.metric-card small {
  display: block;
}

.metric-card span {
  color: #8b98aa;
  font-size: 9.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .05em;
}

.metric-card b {
  margin-top: 4px;
  color: #183f98;
  font-size: 23px;
  line-height: 1;
}

.metric-card small {
  margin-top: 4px;
  color: #9aa6b6;
  font-size: 9.5px;
}

.weak-list {
  display: grid;
  gap: 5px;
  margin: 9px 0 12px;
}

.weak-empty {
  padding: 12px 0;
  color: #94a0b0;
  font-size: 12px;
}

.weak-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 9px;
  border-radius: 9px;
  background: #f7f9fc;
}

.weak-row b {
  color: #314a70;
  font-size: 12px;
}

.weak-row span {
  color: #8a97a8;
  font-size: 11px;
}

.danger-panel {
  box-shadow: none;
}

.bottom-nav {
  position: fixed;
  z-index: 100;
  left: 50%;
  bottom: 0;
  width: min(100%, 760px);
  transform: translateX(-50%);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 5px 7px max(5px, env(safe-area-inset-bottom));
  border-top: 1px solid #dde5ef;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 -7px 22px rgba(32,53,88,.07);
}

.nav-btn {
  min-height: 49px;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: #8a98aa;
  font: inherit;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.nav-btn span,
.nav-btn b {
  display: block;
  line-height: 1;
}

.nav-btn span {
  min-height: 18px;
  font-size: 14px;
  font-weight: 900;
}

.nav-btn b {
  margin-top: 5px;
  font-size: 9.5px;
}

.nav-btn.active {
  background: #edf3ff;
  color: #1a4fcb;
}

@media (min-width: 900px) {
  .view-shell {
    max-width: 900px;
  }

  .bottom-nav {
    width: 560px;
    bottom: 12px;
    border: 1px solid #dfe6ef;
    border-radius: 18px;
    box-shadow: 0 10px 34px rgba(32,53,88,.13);
  }

  body {
    padding-bottom: 90px;
  }
}

@media print {
  .bottom-nav,
  #learnView,
  #egeView,
  #progressView {
    display: none !important;
  }

  #cardsView {
    display: block !important;
  }

  body {
    padding-bottom: 0;
  }
}

/* ===== Tinder-style word cards ===== */

/* Old list stays in DOM as a data source, but is no longer the visible UI. */
#cardsView > .controls-wrap,
#cardsView > #cards,
#cardsView > #emptyState,
#cardsView > footer {
  display: none !important;
}

#cardsView {
  min-height: calc(100dvh - 68px);
  background:
    radial-gradient(circle at 50% -10%, rgba(31,94,255,.11), transparent 34rem),
    #f5f7fb;
}

.tinder-shell {
  width: min(100%, 680px);
  margin: 0 auto;
  padding: 10px 9px 16px;
}

.tinder-topbar {
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 3px 7px;
}

.tinder-kicker {
  color: #8b98aa;
  font-size: 8.5px;
  font-weight: 950;
  letter-spacing: .12em;
}

.tinder-title {
  margin-top: 2px;
  color: #102457;
  font-size: 22px;
  line-height: 1;
  font-weight: 950;
  letter-spacing: -.025em;
}

.tinder-mini-btn {
  width: 34px;
  height: 34px;
  border: 1px solid #dce5f0;
  border-radius: 11px;
  background: rgba(255,255,255,.88);
  color: #43618d;
  font: inherit;
  font-size: 18px;
  font-weight: 900;
  cursor: pointer;
}

.bucket-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 5px;
  padding: 4px;
  border: 1px solid #dfe7f1;
  border-radius: 13px;
  background: rgba(255,255,255,.82);
}

.bucket-tab {
  min-width: 0;
  min-height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #718096;
  font: inherit;
  font-size: 10.5px;
  font-weight: 850;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.bucket-tab b {
  min-width: 20px;
  padding: 2px 5px;
  border-radius: 999px;
  background: #edf1f6;
  color: #7d8999;
  font-size: 9px;
}

.bucket-tab.active {
  background: #edf3ff;
  color: #174ac1;
}

.bucket-tab.active b {
  background: #dbe7ff;
  color: #174ac1;
}

.swipe-help {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 7px;
  align-items: center;
  padding: 7px 6px 5px;
  color: #9aa6b5;
  font-size: 9.5px;
  font-weight: 750;
}

.swipe-help span:nth-child(2) {
  color: #7d8998;
}

.help-left { text-align: left; }
.help-right { text-align: right; }

.tinder-stage {
  position: relative;
  height: min(68dvh, 630px);
  min-height: 440px;
  perspective: 1400px;
}

.tinder-card {
  position: absolute;
  inset: 0;
  border-radius: 22px;
  outline: none;
  cursor: grab;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  will-change: transform, opacity;
  transition:
    transform .24s cubic-bezier(.22,.78,.28,1),
    opacity .20s ease;
}

.tinder-card.dragging {
  cursor: grabbing;
  transition: none;
}

.tinder-card.swipe-left {
  transform: translateX(-125%) rotate(-14deg) !important;
  opacity: .12;
}

.tinder-card.swipe-right {
  transform: translateX(125%) rotate(14deg) !important;
  opacity: .12;
}

.flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform .42s cubic-bezier(.2,.72,.25,1);
}

.tinder-card.flipped .flip-inner {
  transform: rotateY(180deg);
}

.tinder-face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border: 1px solid #dfe6f0;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 18px 48px rgba(28,52,91,.14);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.tinder-front {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px 22px;
  text-align: center;
}

.front-count {
  position: absolute;
  top: 17px;
  right: 18px;
  color: #a5afbd;
  font-size: 10px;
  font-weight: 850;
}

.front-word {
  max-width: 100%;
  color: #123886;
  font-size: clamp(42px, 13vw, 72px);
  line-height: .98;
  font-weight: 950;
  letter-spacing: -.045em;
  overflow-wrap: anywhere;
}

.tap-prompt {
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  width: max-content;
  max-width: calc(100% - 34px);
  display: flex;
  align-items: center;
  gap: 7px;
  color: #91a0b4;
  font-size: 10.5px;
  font-weight: 750;
}

.tap-icon {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #edf3ff;
  color: #1d55d2;
  font-size: 14px;
  font-weight: 900;
}

.tinder-back {
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  user-select: text;
  -webkit-user-select: text;
}

.back-top {
  flex: 0 0 auto;
  min-height: 45px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 7px 10px;
  border-bottom: 1px solid #e8edf4;
  background: rgba(249,251,254,.96);
}

.back-close {
  min-height: 31px;
  padding: 0 9px;
  border: 0;
  border-radius: 9px;
  background: #edf3ff;
  color: #2854b5;
  font: inherit;
  font-size: 10.5px;
  font-weight: 900;
  cursor: pointer;
}

.back-badge {
  color: #98a5b7;
  font-size: 9.5px;
  font-weight: 850;
}

.back-scroll {
  flex: 1 1 auto;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 15px 15px 22px 18px;
  -webkit-overflow-scrolling: touch;
}

/* Reuse the original card typography, but remove redundant card chrome. */
.back-scroll .source-title {
  margin: 0;
  color: #102457;
  font-size: 27px;
  line-height: 1.02;
  font-weight: 950;
  letter-spacing: -.025em;
}

.back-scroll .base-meta {
  margin-top: 6px;
  font-size: 13.5px;
}

.back-scroll > .example {
  margin-top: 6px;
  padding: 8px 9px 8px 28px;
  font-size: 13px;
}

.back-scroll .family-section {
  margin-top: 10px;
  padding-top: 9px;
}

.back-scroll .family-word {
  font-size: 15.5px;
}

.back-scroll .family-meta {
  font-size: 12.5px;
}

.back-scroll .family-content {
  padding-bottom: 10px;
}

.back-scroll .family-content .example {
  margin-top: 5px;
  padding: 7px 8px 7px 26px;
  font-size: 12.5px;
}

.swipe-stamp {
  position: absolute;
  z-index: 20;
  top: 34px;
  padding: 7px 10px;
  border: 3px solid currentColor;
  border-radius: 10px;
  background: rgba(255,255,255,.84);
  font-size: 18px;
  line-height: 1;
  font-weight: 950;
  letter-spacing: .045em;
  opacity: 0;
  pointer-events: none;
}

.swipe-stamp-left {
  right: 18px;
  color: #d36b55;
  transform: rotate(9deg);
}

.swipe-stamp-right {
  left: 18px;
  color: #3e9b67;
  transform: rotate(-9deg);
}

.tinder-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 26px;
  border: 1px dashed #cfd9e7;
  border-radius: 22px;
  background: rgba(255,255,255,.72);
  color: #8492a5;
  text-align: center;
}

.tinder-empty .empty-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  margin-bottom: 12px;
  border-radius: 17px;
  background: #edf3ff;
  color: #285ad0;
  font-size: 22px;
  font-weight: 950;
}

.tinder-empty b {
  color: #314b70;
  font-size: 16px;
}

.tinder-empty span {
  max-width: 300px;
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.4;
}

.tinder-actions {
  display: grid;
  grid-template-columns: 1fr .72fr 1fr;
  gap: 7px;
  margin-top: 9px;
}

.swipe-action {
