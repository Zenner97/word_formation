<!DOCTYPE html>

<html lang="ru">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>Word Formation — Theory, Swipe Cards &amp; EGE Trainer</title>
<style>
  :root {
    --bg: #f4f7fb;
    --paper: #ffffff;
    --ink: #142033;
    --muted: #68778d;
    --blue: #1f5eff;
    --blue-dark: #163fa7;
    --blue-soft: #edf3ff;
    --line: #dfe7f1;
    --shadow: 0 16px 42px rgba(25, 49, 87, .10);
    --radius: 24px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background:
      radial-gradient(circle at 10% 0%, rgba(31,94,255,.10), transparent 28rem),
      linear-gradient(180deg, #f8faff 0%, var(--bg) 36rem);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Roboto, Helvetica, Arial, "Noto Sans", sans-serif;
    line-height: 1.55;
  }

  .hero {
    padding: 56px 20px 24px;
  }

  .hero-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue-dark);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 16px 0 8px;
    max-width: 780px;
    font-size: clamp(36px, 6vw, 66px);
    line-height: 1.02;
    letter-spacing: -.045em;
  }

  .hero p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }

  .controls-wrap {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 12px 20px 16px;
    background: rgba(244,247,251,.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(223,231,241,.8);
  }

  .controls {
    max-width: 980px;
    margin: 0 auto;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(255,255,255,.94);
    box-shadow: 0 8px 28px rgba(25,49,87,.07);
  }

  .search-row {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .search-box {
    position: relative;
    flex: 1;
  }

  .search-box svg {
    position: absolute;
    width: 19px;
    height: 19px;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    opacity: .52;
  }

  #search {
    width: 100%;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 14px;
    outline: none;
    padding: 0 16px 0 45px;
    background: #fbfcff;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    transition: .18s ease;
  }

  #search:focus {
    border-color: rgba(31,94,255,.55);
    box-shadow: 0 0 0 4px rgba(31,94,255,.09);
    background: #fff;
  }

  .result-count {
    min-width: 92px;
    text-align: center;
    font-weight: 800;
    color: var(--blue-dark);
    font-size: 14px;
  }

  .alphabet {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-top: 10px;
    scrollbar-width: thin;
  }

  .alpha-btn {
    flex: 0 0 auto;
    border: 1px solid var(--line);
    background: #fff;
    color: #52637a;
    border-radius: 10px;
    min-width: 36px;
    height: 34px;
    padding: 0 10px;
    font-weight: 800;
    cursor: pointer;
    transition: .15s ease;
  }

  .alpha-btn:hover,
  .alpha-btn.active {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    transform: translateY(-1px);
  }

  .all-btn {
    min-width: 70px;
  }

  .cards {
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 20px 80px;
    display: grid;
    gap: 24px;
  }

  .word-card {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid #e3eaf3;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 34px 38px 38px;
  }

  .word-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: linear-gradient(180deg, var(--blue), #7da2ff);
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 7px;
  }

  .card-number {
    color: #9aa8ba;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: .12em;
  }

  .letter-badge {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: var(--blue-soft);
    color: var(--blue-dark);
    font-weight: 900;
  }

  .word-card h2 {
    margin: 0;
    color: #102457;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .base-meta {
    margin-top: 11px;
    color: #34465d;
    font-size: 17px;
  }

  .ipa {
    font-family: "Segoe UI", "Noto Sans", Arial, sans-serif;
    color: #15294a;
    font-weight: 700;
    letter-spacing: .01em;
  }

  .pos {
    display: inline-flex;
    align-items: center;
    margin-left: 3px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: .78em;
    font-weight: 800;
    font-style: normal;
    vertical-align: .08em;
    white-space: nowrap;
  }

  .pos-noun { background: #eaf8ff; color: #0671a8; }
  .pos-verb { background: #eef1ff; color: #4051b5; }
  .pos-adjective { background: #f4edff; color: #7b38b1; }
  .pos-adverb { background: #eaf8f0; color: #277b4c; }
  .pos-participle { background: #fff4e6; color: #9a5a12; }
  .pos-other { background: #f1f3f6; color: #5e6877; }

  .example {
    position: relative;
    margin-top: 14px;
    border: 1px solid #e7ecf4;
    border-radius: 15px;
    background: #fafcff;
    padding: 13px 16px 13px 41px;
    color: #28384e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 16px;
    font-style: italic;
  }

  .quote-mark {
    position: absolute;
    left: 14px;
    top: 7px;
    color: #9bb2ea;
    font-family: Georgia, serif;
    font-style: normal;
    font-size: 28px;
    line-height: 1;
  }

  .family-section {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .family-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    color: #8996a8;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .family-count {
    letter-spacing: 0;
    text-transform: none;
    font-weight: 700;
    color: #a2adbb;
  }

  .family-list {
    display: grid;
    gap: 4px;
  }

  .family-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    min-width: 0;
  }

  .family-rail {
    position: relative;
  }

  .family-rail::after {
    content: "";
    position: absolute;
    top: 19px;
    bottom: -18px;
    left: 7px;
    width: 2px;
    background: #e2e9f4;
  }

  .family-item:last-child .family-rail::after {
    display: none;
  }

  .family-dot {
    position: absolute;
    top: 11px;
    left: 2px;
    width: 12px;
    height: 12px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 2px #cad8f7;
  }

  .family-content {
    min-width: 0;
    padding: 4px 0 18px 5px;
  }

  .family-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 9px;
  }

  .family-word {
    color: var(--blue-dark);
    font-weight: 900;
    font-size: 20px;
  }

  .family-meta {
    color: #4c5b70;
    font-size: 15px;
  }

  .family-content .example {
    margin-top: 9px;
    padding-top: 11px;
    padding-bottom: 11px;
  }

  .empty {
    display: none;
    max-width: 980px;
    margin: 0 auto 80px;
    padding: 40px 20px;
    text-align: center;
    color: var(--muted);
  }

  .empty strong {
    display: block;
    color: var(--ink);
    font-size: 20px;
    margin-bottom: 4px;
  }

  footer {
    padding: 0 20px 54px;
    text-align: center;
    color: #96a2b1;
    font-size: 13px;
  }

  @media (max-width: 650px) {
    .hero { padding-top: 38px; }
    .controls-wrap { padding-left: 10px; padding-right: 10px; }
    .controls { border-radius: 16px; padding: 10px; }
    .search-row { align-items: stretch; flex-direction: column; }
    .result-count { min-width: 0; text-align: left; padding: 0 3px; }
    .cards { padding: 18px 10px 60px; gap: 16px; }
    .word-card { padding: 27px 21px 29px 25px; border-radius: 19px; }
    .family-head { display: block; }
    .family-word { display: block; margin-bottom: 2px; }
    .example { font-size: 15px; }
  }

  @media print {
    body { background: #fff; }
    .hero { padding: 20px 0 12px; }
    .controls-wrap { display: none; }
    .cards { max-width: none; padding: 0; gap: 12px; }
    .word-card {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid #ccd4df;
      border-radius: 10px;
      padding: 22px 24px;
    }
    .word-card::before { width: 3px; }
    footer { display: none; }
  }

