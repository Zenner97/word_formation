}

.exam-hero {
  background: linear-gradient(135deg, #2556d8 0%, #4d6bf1 55%, #695ae4 100%);
}

.progress-rich-hero {
  background: linear-gradient(135deg, #173e91 0%, #2859c7 55%, #387acb 100%);
}

.section-hero-copy {
